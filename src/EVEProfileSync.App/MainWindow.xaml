<Window x:Class="EVEProfileSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVEProfileSync"
        Width="1280"
        Height="900"
        MinWidth="1024"
        MinHeight="720"
        Background="#07111F"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#07111F" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0C182A" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1C3552" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8FA7C2" />
        <SolidColorBrush x:Key="BodyTextBrush" Color="#D8E7F7" />
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#0EA5E9" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#091423" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#244466" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#132A44" />

        <Style TargetType="Border" x:Key="CardBorderStyle">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F8FBFF" />
            <Setter Property="Background" Value="{StaticResource HighlightBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#123252" />
                    <Setter Property="BorderBrush" Value="#67E8F9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#06101C" />
            <Setter Property="Background" Value="#F8FBFF" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#06101C" />
            <Setter Property="Background" Value="#F8FBFF" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="1.4*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2"
                Padding="18"
                CornerRadius="14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#081321" Offset="0" />
                    <GradientStop Color="#0E2238" Offset="0.5" />
                    <GradientStop Color="#123252" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#F7FBFF"
                           Text="EVEProfileSync" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#B3CAE4"
                           Text="Sync UI layout and Neocom colors between EVE profiles with automatic backups." />
                <TextBlock Margin="0,10,0,0"
                           Foreground="#67E8F9"
                           Text="{Binding StatusText}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="0,18,18,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Profile" />
                                <Border Margin="10,0,0,0"
                                        Padding="8,3"
                                        Background="#112742"
                                        CornerRadius="999">
                                    <TextBlock Foreground="#7DD3FC" Text="Profile Scope" />
                                </Border>
                            </DockPanel>
                            <TextBlock Margin="0,4,0,8"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Choose the EVE settings root and the source profile." />
                            <TextBlock FontWeight="SemiBold" Text="Settings Root" />
                            <DockPanel Margin="0,4,0,8" LastChildFill="True">
                                <Button Width="80" Margin="0,0,8,0" Click="OnBrowseClick">Browse</Button>
                                <Button Width="80" Margin="0,0,8,0" Click="OnRefreshClick">Refresh</Button>
                                <TextBox Text="{Binding ManualRootPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock FontWeight="SemiBold" Text="Source Profile" />
                            <ComboBox Margin="0,4,0,0"
                                      ItemsSource="{Binding Profiles}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedSourceProfile, Mode=TwoWay}"
                                      SelectionChanged="OnSourceProfileSelectionChanged" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}" Padding="14">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel LastChildFill="False">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Account Overview" />
                                    <Border Margin="10,0,0,0"
                                            Padding="8,3"
                                            Background="#1C214B"
                                            CornerRadius="999">
                                        <TextBlock Foreground="#A5B4FC" Text="Account Info" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Margin="0,4,0,8"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="To determine account names, launch an account, make a UI change, close the account, and refresh this window." />
                                <Button Width="150"
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Left"
                                        Click="OnRefreshAccountOverviewClick">Refresh Last Modified</Button>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding AccountOverviewItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="8"
                                                Background="#091423"
                                                BorderBrush="#1E3A5F"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                    <TextBlock FontWeight="SemiBold"
                                                               Foreground="#F8FBFF"
                                                               Text="{Binding DisplayName}" />
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,4,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding LastModifiedText}" />
                                                <TextBox Grid.Row="2"
                                                         Margin="0,6,8,0"
                                                         Text="{Binding DraftLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Grid.Row="2"
                                                        Grid.Column="1"
                                                        Width="68"
                                                        Margin="0,6,0,0"
                                                        Tag="{Binding}"
                                                        Click="OnSaveAccountLabelClick">Save</Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel LastChildFill="False">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="UI Layout" />
                                    <Border Margin="10,0,0,0"
                                            Padding="8,3"
                                            Background="#0F2B24"
                                            CornerRadius="999">
                                        <TextBlock Foreground="#86EFAC" Text="Character-Scoped" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Margin="0,4,0,8"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="UI layout changes apply from one character source to selected character targets only. The selected source character is excluded from targets." />
                                <TextBlock FontWeight="SemiBold" Text="Layout Source Character" />
                                <ComboBox Margin="0,4,0,8"
                                          ItemsSource="{Binding WindowLayoutSources}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedWindowLayoutSource, Mode=TwoWay}"
                                          SelectionChanged="OnSelectionChanged" />
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <Button Width="90" Margin="0,0,8,0" Click="OnSelectCharacterTargetsClick">Select All</Button>
                                    <Button Width="90" Click="OnDeselectCharacterTargetsClick">Deselect All</Button>
                                </StackPanel>
                            </StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Bottom"
                                        Margin="0,12,0,0"
                                        Padding="0,8"
                                        Click="OnSyncLayoutClick">Sync UI Layout</Button>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                    <ItemsControl ItemsSource="{Binding CharacterTargets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0,0,0,8"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Click="OnSelectionChanged"
                                                          Content="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Style="{StaticResource CardBorderStyle}" Padding="14">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel LastChildFill="False">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="NEOCOM Colors" />
                                    <Border Margin="10,0,0,0"
                                            Padding="8,3"
                                            Background="#34153F"
                                            CornerRadius="999">
                                        <TextBlock Foreground="#F0ABFC" Text="Account-Scoped" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Margin="0,4,0,8"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="NEOCOM colors are controlled at the account level, not character, so changes apply to all characters within an account." />
                                <TextBlock FontWeight="SemiBold" Text="NEOCOM Source Account" />
                                <ComboBox Margin="0,4,0,8"
                                          ItemsSource="{Binding NeocomSources}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedNeocomSource, Mode=TwoWay}"
                                          SelectionChanged="OnSelectionChanged" />
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <Button Width="90" Margin="0,0,8,0" Click="OnSelectAccountTargetsClick">Select All</Button>
                                    <Button Width="90" Click="OnDeselectAccountTargetsClick">Deselect All</Button>
                                </StackPanel>
                            </StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Bottom"
                                        Margin="0,12,0,0"
                                        Padding="0,8"
                                        Click="OnSyncNeocomClick">Sync Colors</Button>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                    <ItemsControl ItemsSource="{Binding AccountTargets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0,0,0,8"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Click="OnSelectionChanged"
                                                          Content="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.3*" />
                <RowDefinition Height="0.8*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Sync Preview" />
                        <TextBlock Margin="0,4,0,10" Foreground="{StaticResource MutedTextBrush}" Text="Review affected files and planned sync actions." />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding PreviewItems}" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}" Padding="14">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Export / Restore" />
                    <TextBlock Margin="0,4,0,10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Export writes a portable backup file into the app folder. Restore lets you browse to one of those files, then confirms exactly what will be overwritten before it restores anything." />
                    <TextBlock Margin="0,0,0,10"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding ExportFolderPath}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Width="120" Margin="0,0,10,0" Click="OnExportClick">Export</Button>
                        <Button Width="120" Click="OnRestoreClick">Restore</Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
